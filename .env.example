# Copy this file to .env and replace the dataset path for the current machine.
# The shell launchers load .env automatically; explicitly exported variables
# take precedence over values in .env.

MMLSV2_DATA_ROOT=/path/to/mmlsv2_mapped_mars_ls
DEVICE=cuda:0
NUM_WORKERS=4
BATCH_SIZE=32
PYTHON_BIN=python
FINALIZE_RESULTS=0
